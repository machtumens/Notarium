# Backend secrets — provision via `wrangler secret put <NAME>`
# For local dev, copy to backend/.dev.vars (never commit that file)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8787/auth/google/callback
OAUTH_TOKEN_AES_KEY=

# Cloudflare GraphQL Analytics (Tier C ops dashboard) — optional.
# Token needs the "Account Analytics: Read" permission.
# CF_API_TOKEN=
# CF_ACCOUNT_ID=
